PING_MESSAGE="ping pong"

# Database
DATABASE_URL="postgresql://marketplace_user:securepassword@127.0.0.1:5432/marketplace_db?schema=marketplace"
# Direct URL used by Prisma Migrate (same as DATABASE_URL unless using pooler like PgBouncer)
DIRECT_URL="postgresql://marketplace_user:securepassword@127.0.0.1:5432/marketplace_db?schema=marketplace"

# JWT
JWT_SECRET="marketplace-jwt-secret-dev-32chars-minimum-length"
JWT_REFRESH_SECRET="marketplace-refresh-secret-dev-32chars-minimum-length"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Email (Nodemailer)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@marketplace.dz"
